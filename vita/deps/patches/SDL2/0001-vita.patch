+/* PS Vita Wesnoth port: UTF-8 to UTF-16, at most max - 1 units and a terminator. */
+static void utf8_to_utf16(const char *src, uint16_t *dst, int max)
+{
+    const unsigned char *s = (const unsigned char *)src;
+    int n = 0;
+    while (*s && n < max - 1) {
+        uint32_t c;
+        int extra;
+        if (*s < 0x80) {
+            c = *s;
+            extra = 0;
+        } else if ((*s & 0xE0) == 0xC0) {
+            c = *s & 0x1F;
+            extra = 1;
+        } else if ((*s & 0xF0) == 0xE0) {
+            c = *s & 0x0F;
+            extra = 2;
+        } else {
+            c = *s & 0x07;
+            extra = 3;
+        }
+        s++;
+        while (extra-- > 0 && (*s & 0xC0) == 0x80) {
+            c = (c << 6) | (*s++ & 0x3F);
+        }
+        if (c >= 0x10000) {
+            if (n + 2 >= max) {
+                break;
+            }
+            c -= 0x10000;
+            dst[n++] = (uint16_t)(0xD800 | (c >> 10));
+            dst[n++] = (uint16_t)(0xDC00 | (c & 0x3FF));
+        } else {
+            dst[n++] = (uint16_t)c;
+        }
+    }
+    dst[n] = 0;
+}
