+/* PS Vita Wesnoth port: the GPU's region clip only works in whole 32x32 tiles, so draws spilled out
+ * of their clip rectangle by up to 31 pixels (Wesnoth redraws only the parts of the screen that
+ * changed, and those spills left black boxes and stale text behind). Everything SDL draws here is
+ * triangles; rectangles - copies, fills, lines - come as pairs of triangles over an axis-aligned
+ * box, and those are cut to the clip rectangle exactly, texture coordinates following the edges. */
+static void clip_vertex(float *x, float *y, float *uv, const float *m, float x0, float y0, float x1, float y1)
+{
+    float nx = SDL_clamp(*x, x0, x1);
+    float ny = SDL_clamp(*y, y0, y1);
+    if (uv) {
+        float dx = nx - *x, dy = ny - *y;
+        uv[0] += m[0] * dx + m[1] * dy;
+        uv[1] += m[2] * dx + m[3] * dy;
+    }
+    *x = nx;
+    *y = ny;
+}
+
+static void clip_quads(VITA_GXM_RenderData *data, SDL_RenderCommand *cmd, const SDL_RenderCommand *last)
+{
+    const float x0 = (float)data->drawstate.cliprect.x;
+    const float y0 = (float)data->drawstate.cliprect.y;
+    const float x1 = x0 + data->drawstate.cliprect.w;
+    const float y1 = y0 + data->drawstate.cliprect.h;
+
+    for (;; cmd = cmd->next) {
+        const SDL_bool textured = cmd->data.draw.texture != NULL;
+        const size_t stride = textured ? sizeof(texture_vertex) : sizeof(color_vertex);
+        char *base = (char *)cmd->data.draw.first;
+        size_t q, i;
+
+        for (q = 0; cmd->command == SDL_RENDERCMD_GEOMETRY && q + 6 <= cmd->data.draw.count; q += 6) {
+            float *p[6];
+            float minx, maxx, miny, maxy;
+            float m[4] = { 0, 0, 0, 0 };
+            SDL_bool box = SDL_TRUE;
+
+            for (i = 0; i < 6; i++) {
+                p[i] = (float *)(base + (q + i) * stride);
+            }
+            minx = maxx = p[0][0];
+            miny = maxy = p[0][1];
+            for (i = 1; i < 6; i++) {
+                minx = SDL_min(minx, p[i][0]);
+                maxx = SDL_max(maxx, p[i][0]);
+                miny = SDL_min(miny, p[i][1]);
+                maxy = SDL_max(maxy, p[i][1]);
+            }
+            if (minx >= x0 && maxx <= x1 && miny >= y0 && maxy <= y1) {
+                continue; /* inside: nothing to cut */
+            }
+            for (i = 0; i < 6 && box; i++) {
+                const SDL_Color *c0 = (const SDL_Color *)(p[0] + (textured ? 4 : 2));
+                const SDL_Color *ci = (const SDL_Color *)(p[i] + (textured ? 4 : 2));
+                box = (p[i][0] == minx || p[i][0] == maxx) && (p[i][1] == miny || p[i][1] == maxy) &&
+                      SDL_memcmp(c0, ci, sizeof(SDL_Color)) == 0;
+            }
+            if (!box) {
+                continue; /* some other shape: left to the tile clip */
+            }
+            if (textured) {
+                /* u and v as linear functions of x and y, from the first triangle */
+                const float ax = p[1][0] - p[0][0], ay = p[1][1] - p[0][1];
+                const float bx = p[2][0] - p[0][0], by = p[2][1] - p[0][1];
+                const float det = ax * by - bx * ay;
+                if (det == 0.0f) {
+                    continue;
+                }
+                for (i = 0; i < 2; i++) {
+                    const float da = p[1][2 + i] - p[0][2 + i], db = p[2][2 + i] - p[0][2 + i];
+                    m[i * 2] = (da * by - db * ay) / det;
+                    m[i * 2 + 1] = (ax * db - bx * da) / det;
+                }
+            }
+            for (i = 0; i < 6; i++) {
+                clip_vertex(&p[i][0], &p[i][1], textured ? &p[i][2] : NULL, m, x0, y0, x1, y1);
+            }
+        }
+        if (cmd == last) {
+            break;
+        }
+    }
+}
